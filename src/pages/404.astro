---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found — Abhinav Thakur">
  <section class="wrap nf">
    <p class="label label--caps">404</p>
    <h1 class="h1">This page doesn’t exist.</h1>
    <p class="lede">The link may be old, or the case study may have moved.</p>
    <p><a class="btn" href={url('/')}>Back to the homepage <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>
</Base>
<style>
  .nf { padding-block: clamp(5rem, 14vw, 11rem); display: grid; gap: 1.5rem; }
</style>
