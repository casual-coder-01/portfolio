---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MetaList from '../../components/MetaList.astro';
import WorkVisual from '../../components/WorkVisual.astro';
import Lightbox from '../../components/Lightbox.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(i + 1) % entries.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const n = String(d.order).padStart(2, '0');
---
<Base title={`${d.title} — Abhinav Thakur`} description={d.seoDescription} type="article" tone={d.tone}>
  <article class="cs">
    <header class="cs-hero wrap">
      <a class="cs-back label" href={url('/#work')}>← All work</a>
      <p class="label label--caps cs-kicker">Case study {n} · {d.kicker}</p>
      <h1 class="h1 cs-title balance">{d.title}</h1>
      <p class="lede cs-summary pretty">{d.summary}</p>
      <div class="cs-meta"><MetaList items={d.meta} /></div>
      <div class="cs-tools">
        <p class="label label--caps">Tools</p>
        <ul class="tags" role="list">{d.tools.map((t) => <li class="tag">{t}</li>)}</ul>
      </div>
    </header>

    {d.visual !== 'creative' && (
      <div class="wrap cs-visual" data-reveal>
        <WorkVisual kind={d.visual} size="hero" />
      </div>
    )}

    <div class="wrap cs-body">
      <Content />
    </div>

    <nav class="wrap cs-next" aria-label="Next case study">
      <a href={url(`/work/${next.id}/`)} class="cs-next__link">
        <span class="label label--caps">Next · Case study {String(next.data.order).padStart(2, '0')}</span>
        <span class="h2 cs-next__title">{next.data.cardTitle} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
  <Lightbox />
</Base>

<style>
  .cs { padding-bottom: 2rem; }
  .cs-hero { padding-top: clamp(2.5rem, 6vw, 5.5rem); padding-bottom: clamp(2rem, 4vw, 3.5rem); display: grid; gap: 1.25rem; }
  .cs-back { text-decoration: none; justify-self: start; padding-block: 0.4rem; }
  .cs-back:hover { color: var(--ink); }
  .cs-kicker { margin-top: 1rem; }
  .cs-title { max-width: 20ch; }
  .cs-summary { max-width: 44rem; }
  .cs-meta { margin-top: 1.25rem; }
  .cs-tools { display: grid; gap: 0.6rem; }
  .cs-visual { margin-bottom: clamp(1rem, 3vw, 2rem); }
  .cs-visual :global(.wv) { min-height: clamp(18rem, 40vw, 30rem); }
  .cs-body { padding-bottom: clamp(3rem, 6vw, 5rem); }
  .cs-next { border-top: 1px solid var(--ink); padding-block: 2rem 4rem; }
  .cs-next__link { display: grid; gap: 0.75rem; text-decoration: none; }
  .cs-next__title { transition: color 0.2s var(--ease); }
  .cs-next__link:hover .cs-next__title { color: var(--accent); }
  .cs-next__link .arrow { display: inline-block; transition: transform 0.25s var(--ease); }
  .cs-next__link:hover .arrow { transform: translateX(6px); }
</style>
