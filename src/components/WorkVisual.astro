---
/**
 * Project-specific preview visuals for the homepage and case-study headers.
 * Built from real artefacts (stage configs, template copy, actual creatives) — no fake UI.
 */
import { Picture } from 'astro:assets';
import TemplateCard from './TemplateCard.astro';
import { rbpCampaign, megoCampaign } from '../data/creative';

interface Props { kind: 'markets' | 'crm' | 'outbound' | 'whatsapp' | 'creative'; size?: 'card' | 'hero'; mosaic?: boolean }
const { kind, size = 'card', mosaic = false } = Astro.props;

const markets = ['France', 'Canada', 'USA', 'Malaysia', 'UAE', 'Saudi Arabia', 'South Korea', 'India'];
const stages = [
  ['Enquiry received', 10], ['Meeting', 25], ['Quote given', 40], ['Documents & KYC submitted', 55],
  ['Documents verified', 70], ['Payment received', 85], ['Activated', 100],
] as const;
const chain = [
  ['Target market', 'segment · licence · region'],
  ['Sales Navigator', 'accounts · CEO / founder'],
  ['Evaboot · PhantomBuster', 'export · enrich · verify'],
  ['SBL · Instantly', 'LinkedIn + email sequences'],
  ['Replies → score', 'hot · warm · qualified · low'],
  ['Zoho CRM', 'partnership stage · next action'],
];
const collage = mosaic
  ? [rbpCampaign[0], megoCampaign[0], rbpCampaign[3], megoCampaign[1], rbpCampaign[2], megoCampaign[3]]
  : [rbpCampaign[0], megoCampaign[0], rbpCampaign[2], megoCampaign[1], rbpCampaign[6]];
---
<div class:list={['wv', `wv--${kind}`, `wv--${size}`]} aria-hidden={size === 'card' ? 'true' : undefined}>
  {kind === 'markets' && (
    <div class="mk">
      <ol class="mk__list" role="list">
        {markets.map((m, i) => (
          <li><span class="label">{String(i + 1).padStart(2, '0')}</span><span class="mk__name">{m}</span></li>
        ))}
      </ol>
      <p class="mk__foot label">SaaS · BaaS · payment infrastructure</p>
    </div>
  )}

  {kind === 'crm' && (
    <div class="crm">
      <p class="label label--caps crm__title">Pipeline · white-label partner onboarding</p>
      <ol class="crm__list" role="list">
        {stages.map(([name, p]) => (
          <li style={`--p:${p}`}>
            <span class="crm__name">{name}</span>
            <span class="crm__bar"><span></span></span>
            <span class="label crm__p">{p}%</span>
          </li>
        ))}
      </ol>
      <p class="label crm__foot">Stage probabilities as configured</p>
    </div>
  )}

  {kind === 'outbound' && (
    <div class="ob">
      <ol class="ob__list" role="list">
        {chain.map(([name, note], i) => (
          <li>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <span class="ob__name">{name}</span>
            <span class="label ob__note">{note}</span>
          </li>
        ))}
      </ol>
    </div>
  )}

  {kind === 'whatsapp' && (
    <div class="wa">
      <TemplateCard
        compact
        name="mego_intern_final_hours · reusable draft"
        body={"Last call, {{1}}. Registration and the entry exam for cohort {{2}} both close at the end of {{3}}.\n\nAfter that, the next opportunity is a future cohort. Registering is free and takes a few minutes.\n\nIf something is holding you back, just reply here and someone from our team will help."}
        footer="Reply STOP to opt out anytime"
      />
    </div>
  )}

  {kind === 'creative' && (
    <div class:list={['cr', { 'cr--mosaic': mosaic }]}>
      {collage.map((c, i) => (
        <div class={`cr__item cr__item--${i}`} style={`--r:${(c.src.width / c.src.height).toFixed(4)}`}>
          <Picture src={c.src} alt={size === 'card' ? '' : c.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 520, 760]} sizes="(max-width: 40rem) 33vw, 20vw" loading="lazy" decoding="async" quality={78} />
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .wv { width: 100%; height: 100%; }

  /* Markets */
  .mk { height: 100%; display: grid; align-content: space-between; gap: 2rem; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--paper-2); border-radius: var(--radius); }
  .mk__list { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.2rem 1.5rem; }
  .mk__list li { display: flex; align-items: baseline; gap: 1rem; border-bottom: 1px solid var(--rule); padding-block: 0.35rem; }
  .mk__name { font-size: clamp(1.35rem, 0.9rem + 1.6vw, 2.5rem); font-weight: 620; letter-spacing: -0.04em; line-height: 1.05; }
  .mk__list li:nth-child(4n + 2) .mk__name, .mk__list li:nth-child(4n + 3) .mk__name { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; }

  /* CRM */
  .crm { height: 100%; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--paper-2); border-radius: var(--radius); display: grid; gap: 1.25rem; align-content: center; }
  .crm__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.7rem; }
  .crm__list li { display: grid; grid-template-columns: minmax(8.5rem, 1.1fr) 2fr 2.75rem; align-items: center; gap: 1rem; }
  .crm__name { font-size: var(--fs-sm); font-weight: 550; line-height: 1.25; }
  .crm__bar { height: 6px; background: var(--paper-3); border-radius: 3px; overflow: hidden; }
  .crm__bar span { display: block; height: 100%; width: calc(var(--p) * 1%); background: var(--ink); border-radius: 3px; }
  .crm__list li:last-child .crm__bar span { background: var(--accent); }
  .crm__p { text-align: right; }

  /* Outbound */
  .ob { height: 100%; padding: clamp(1.25rem, 3vw, 2.5rem); background: var(--paper-2); border-radius: var(--radius); display: grid; align-content: center; }
  .ob__list { margin: 0; padding: 0; list-style: none; display: grid; }
  .ob__list li { display: grid; grid-template-columns: 2rem 1fr auto; align-items: baseline; gap: 0.75rem; padding-block: 0.7rem; border-bottom: 1px solid var(--rule); position: relative; }
  .ob__list li:first-child { border-top: 1px solid var(--ink); }
  .ob__name { font-weight: 600; font-size: var(--fs-md); letter-spacing: -0.01em; }
  .ob__note { text-align: right; }
  .ob__list li:last-child .ob__name::after { content: ' ●'; color: var(--accent); font-size: 0.6em; vertical-align: middle; }
  @media (max-width: 36rem) {
    .ob__list li { grid-template-columns: 2rem 1fr; }
    .ob__note { grid-column: 2; text-align: left; }
  }

  /* WhatsApp */
  .wa { height: 100%; display: grid; place-items: center; padding: clamp(1.25rem, 4vw, 3rem); background: var(--paper-2); border-radius: var(--radius); }
  .wa :global(.tpl) { width: 100%; max-width: 26rem; }

  /* Creative collage — equal heights, never cropped */
  .cr { display: flex; gap: clamp(0.5rem, 1vw, 0.9rem); align-items: flex-start; }
  .cr__item { flex: var(--r) 1 0; min-width: 0; overflow: hidden; border-radius: var(--radius); background: var(--night-2); }
  .cr__item :global(img) { width: 100%; height: auto; aspect-ratio: var(--r); }
  @media (max-width: 40rem) { .cr:not(.cr--mosaic) .cr__item--3, .cr:not(.cr--mosaic) .cr__item--4 { display: none; } }
  .cr--mosaic { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.5rem, 1vw, 0.8rem); }
  .cr--mosaic .cr__item :global(img) { aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 30%; height: 100%; }
  .cr--mosaic .cr__item:nth-child(2) { transform: translateY(8%); }
  .cr--mosaic .cr__item:nth-child(5) { transform: translateY(8%); }
</style>
