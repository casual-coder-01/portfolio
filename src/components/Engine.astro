---
/**
 * The revenue engine: five outreach channels wired into one CRM, then out to sales.
 * Wires are an SVG stretched over the grid rows; gold pulses run along them
 * unless the viewer prefers reduced motion.
 */
const inputs = [
  ['LinkedIn', 'Sales Navigator · Evaboot · SBL'],
  ['Google Maps', 'PhantomBuster · 379-query matrix'],
  ['Email', 'Instantly · Zoho Marketing Automation'],
  ['WhatsApp', 'Interakt'],
  ['Calling', 'Logged against the lead'],
];
const outputs = [
  ['Scored', 'hot · warm · qualified · low'],
  ['Demo booked', 'routed to sales automatically'],
  ['Deal closed', 'commission traced to agent'],
];
const ys = inputs.map((_, i) => 10 + i * 20);
---
<figure class="eng" data-reveal aria-label="Five outreach channels feed one Zoho CRM, which routes scored leads to sales">
  <ol class="eng__in" role="list">
    {inputs.map(([n, t]) => <li><b>{n}</b><span>{t}</span></li>)}
  </ol>

  <svg class="eng__wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    {ys.map((y, i) => (
      <>
        <path class="eng__wire" d={`M0 ${y} C 55 ${y}, 45 50, 100 50`} />
        <path class="eng__pulse" pathLength="100" d={`M0 ${y} C 55 ${y}, 45 50, 100 50`} style={`--i:${i}`} />
      </>
    ))}
  </svg>

  <div class="eng__core">
    <span class="eng__ring" aria-hidden="true"></span>
    <p class="label label--caps">One CRM</p>
    <p class="eng__name">Zoho CRM</p>
    <p class="eng__fields">source · stage · owner · next action</p>
  </div>

  <ol class="eng__out" role="list">
    {outputs.map(([n, t]) => <li><b>{n}</b><span>{t}</span></li>)}
  </ol>
</figure>

<style>
  .eng {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 2fr) minmax(0, 3.2fr) minmax(0, 3fr);
    align-items: stretch; gap: 0; margin: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem); border: 1px solid var(--line); border-radius: 14px;
    background: radial-gradient(60% 80% at 62% 50%, rgba(217, 178, 111, 0.09), transparent 70%), var(--bg-2);
  }
  .eng__in, .eng__out { margin: 0; padding: 0; list-style: none; display: grid; }
  .eng__in { grid-template-rows: repeat(5, 1fr); }
  .eng__in li, .eng__out li { display: grid; align-content: center; gap: 0.15rem; padding: 0.55rem 0.9rem; border: 1px solid var(--line-2); border-radius: 10px; background: var(--bg); margin-block: 0.3rem; }
  .eng__in b, .eng__out b { font-weight: 650; font-size: var(--fs-sm); }
  .eng__in span, .eng__out span { font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--text-3); letter-spacing: 0.03em; }
  .eng__wires { width: 100%; height: 100%; overflow: visible; }
  .eng__wire { fill: none; stroke: var(--line-2); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .eng__pulse { fill: none; stroke: var(--gold); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-dasharray: 0 1; opacity: 0; }
  .eng__core {
    position: relative; align-self: center; display: grid; justify-items: center; text-align: center; gap: 0.35rem;
    padding: clamp(1.25rem, 2.5vw, 2rem) 1rem; border-radius: 16px; border: 1px solid rgba(217, 178, 111, 0.6);
    background: linear-gradient(180deg, rgba(217, 178, 111, 0.12), rgba(217, 178, 111, 0.02)), var(--bg);
    box-shadow: 0 0 60px -12px rgba(217, 178, 111, 0.45);
  }
  .eng__ring { position: absolute; inset: -10px; border-radius: 22px; border: 1px solid rgba(217, 178, 111, 0.25); }
  .eng__name { font-family: var(--font-display); font-stretch: 118%; font-weight: 800; font-size: clamp(1.3rem, 0.9rem + 1.4vw, 2rem); letter-spacing: -0.03em; line-height: 1; }
  .eng__fields { font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--gold); }
  .eng__out { align-content: center; padding-left: clamp(1rem, 2.5vw, 2rem); position: relative; }
  .eng__out::before { content: ''; position: absolute; left: 0; top: 50%; width: clamp(1rem, 2.5vw, 2rem); height: 1px; background: var(--gold); }
  .eng__out li:last-child { border-color: var(--gold); }
  .eng__out li:last-child b { color: var(--gold); }

  @media (prefers-reduced-motion: no-preference) {
    .eng__pulse { stroke-dasharray: 6 94; stroke-dashoffset: 100; opacity: 1; animation: eng-flow 3.2s linear infinite; animation-delay: calc(var(--i) * -0.64s); }
    .eng__ring { animation: eng-breathe 3.2s ease-in-out infinite; }
  }
  @keyframes eng-flow { to { stroke-dashoffset: 0; } }
  @keyframes eng-breathe { 50% { inset: -16px; opacity: 0.2; } }

  @media (max-width: 56rem) {
    .eng { grid-template-columns: 1fr; gap: 1rem; }
    .eng__wires { display: none; }
    .eng__in { grid-template-rows: none; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: 0.5rem; }
    .eng__in li, .eng__out li { margin: 0; }
    .eng__core::before { content: '↓'; position: absolute; top: -1.1rem; color: var(--gold); }
    .eng__out { padding-left: 0; gap: 0.5rem; padding-top: 1rem; }
    .eng__out::before { left: 50%; top: 0; width: 1px; height: 1rem; }
  }
</style>
