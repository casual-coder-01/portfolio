---
/**
 * Flow — a process "rail" diagram. Semantic ordered list, responsive:
 * horizontal rail on wide screens (wraps into rows), vertical rail on phones.
 */
interface Step { label: string; note?: string; tool?: string }
interface Props {
  steps: Step[];
  title?: string;
  caption?: string;
  cols?: number;            // max columns on desktop (default: min(steps, 4))
  compact?: boolean;        // smaller type, for secondary flows
  accentLast?: boolean;     // highlight the final step
  start?: number;           // numbering offset
}
const { steps, title, caption, cols, compact = false, accentLast = true, start = 1 } = Astro.props;
const c = cols ?? Math.min(steps.length, 4);
---
<figure class:list={['flow', { 'flow--compact': compact }]} style={`--cols:${c}`} data-reveal>
  {title && <figcaption class="flow__title label label--caps">{title}</figcaption>}
  <ol class="flow__list" role="list">
    {steps.map((s, i) => (
      <li class:list={['flow__step', { 'is-last': accentLast && i === steps.length - 1 }]} style={`--i:${i}`}>
        <span class="flow__node" aria-hidden="true"></span>
        <span class="flow__num label">{String(i + start).padStart(2, '0')}</span>
        <span class="flow__label">{s.label}</span>
        {s.tool && <span class="flow__tool label">{s.tool}</span>}
        {s.note && <span class="flow__note">{s.note}</span>}
      </li>
    ))}
  </ol>
  {caption && <p class="flow__caption label">{caption}</p>}
</figure>

<style>
  .flow { margin: 0; }
  .flow__title { display: block; margin-bottom: 1.25rem; }
  .flow__list {
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    row-gap: 2.25rem; column-gap: 0; margin: 0; padding: 0; list-style: none;
  }
  .flow__step {
    position: relative; display: grid; align-content: start; gap: 0.35rem;
    padding: 1.35rem 1.25rem 0 0;
  }
  /* rail */
  .flow__step::before {
    content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--ink);
    transform-origin: left;
  }
  .flow__node {
    position: absolute; left: 0; top: -4px; width: 9px; height: 9px; border-radius: 50%;
    background: var(--paper); border: 1.5px solid var(--ink);
  }
  .night .flow__node { background: var(--night); }
  .flow__step.is-last .flow__node { background: var(--accent); border-color: var(--accent); }
  .flow__num { color: var(--ink-3); }
  .flow__label { font-weight: 600; font-size: var(--fs-md); line-height: 1.25; letter-spacing: -0.01em; color: var(--ink); }
  .flow__tool { color: var(--accent-ink); }
  .flow__note { font-size: var(--fs-sm); line-height: 1.5; color: var(--ink-2); max-width: 22rem; }
  .flow__caption { margin-top: 1.5rem; max-width: 44rem; }

  .flow--compact .flow__label { font-size: var(--fs-base); }
  .flow--compact .flow__step { padding-top: 1.1rem; }
  .flow--compact .flow__list { row-gap: 1.75rem; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .flow[data-reveal] { opacity: 1; transform: none; }
    :global(.js) .flow[data-reveal] .flow__step::before { transform: scaleX(0); transition: transform 0.7s var(--ease); transition-delay: calc(var(--i) * 90ms); }
    :global(.js) .flow[data-reveal] .flow__step > * { opacity: 0; transition: opacity 0.6s var(--ease); transition-delay: calc(var(--i) * 90ms + 150ms); }
    :global(.js) .flow[data-reveal].is-in .flow__step::before { transform: scaleX(1); }
    :global(.js) .flow[data-reveal].is-in .flow__step > * { opacity: 1; }
  }

  /* Phones: vertical rail */
  @media (max-width: 40rem) {
    .flow__list { grid-template-columns: 1fr; row-gap: 0; }
    .flow__step { padding: 0 0 1.6rem 1.75rem; }
    .flow__step::before { left: 4px; right: auto; top: 6px; bottom: 0; width: 1px; height: auto; transform-origin: top; }
    .flow__step:last-child::before { display: none; }
    .flow__node { top: 3px; }
    :global(.js) .flow[data-reveal] .flow__step::before { transform: scaleY(0); }
    :global(.js) .flow[data-reveal].is-in .flow__step::before { transform: scaleY(1); }
  }
  @media (min-width: 40.01rem) and (max-width: 60rem) {
    .flow__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
