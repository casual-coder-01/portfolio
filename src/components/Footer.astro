---
import { site } from '../data/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap ftr__inner">
    <p class="ftr__name">{site.name}</p>
    <p class="label ftr__note">
      Client names and contacts are withheld. Brand work shown is my own production for RBP Finivis and MEGO Forex.
    </p>
    <p class="label ftr__meta">
      <span>© {year}</span>
      <span>{site.location}</span>
      <a class="link" href={url('/#top')}>Back to top ↑</a>
    </p>
  </div>
</footer>
<style>
  .ftr { border-top: 1px solid var(--rule); padding-block: 2.5rem 3rem; }
  .ftr__inner { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  .ftr__name { font-weight: 650; letter-spacing: -0.015em; }
  .ftr__note { max-width: 44rem; }
  .ftr__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  @media (min-width: 56rem) {
    .ftr__inner { grid-template-columns: 1fr 2fr auto; align-items: baseline; }
  }
</style>
