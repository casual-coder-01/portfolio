---
/**
 * "Signal" — the hero visual. Five gold waveforms (the five outreach channels)
 * travel in from the left and converge into one pulsing core (the CRM).
 * Strings bend away from the pointer, gain energy on scroll, and follow the
 * music when the Sound toggle is on (reads window.__soundAnalyser).
 *
 * Canvas 2D, no library. Starts after the page has painted, pauses when off
 * screen or in a background tab, and draws a single still frame for viewers
 * who prefer reduced motion.
 */
interface Props {
  /** Where the core sits, as fractions of the hero box: [x, y] on desktop and on mobile. */
  core?: [number, number];
  coreMobile?: [number, number];
}
const { core = [0.74, 0.3], coreMobile = [0.62, 0.11] } = Astro.props;
---
<canvas class="signal" data-signal data-core={core.join(',')} data-core-m={coreMobile.join(',')} aria-hidden="true"></canvas>

<style>
  .signal { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 1.6s var(--ease); }
  .signal.is-on { opacity: 1; }
</style>

<script>
  type Stream = { y0: number; amp: number; freq: number; speed: number; phase: number; dots: { t: number; v: number; r: number }[] };

  const GOLD = '217, 178, 111';
  const GOLD_HI = '242, 213, 155';
  // faint chromatic echoes give the strings a holographic edge (same hues as the .holo card foil)
  const ECHO = ['111, 214, 255', '196, 140, 255'];

  function sprite(radius: number, rgb: string) {
    const c = document.createElement('canvas');
    c.width = c.height = radius * 2;
    const g = c.getContext('2d')!;
    const grad = g.createRadialGradient(radius, radius, 0, radius, radius, radius);
    grad.addColorStop(0, `rgba(${rgb}, 1)`);
    grad.addColorStop(0.25, `rgba(${rgb}, 0.45)`);
    grad.addColorStop(1, `rgba(${rgb}, 0)`);
    g.fillStyle = grad;
    g.fillRect(0, 0, radius * 2, radius * 2);
    return c;
  }

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const [cx, cy] = (canvas.dataset.core ?? '0.74,0.3').split(',').map(Number);
    const [mx, my] = (canvas.dataset.coreM ?? '0.62,0.11').split(',').map(Number);
    const dot = sprite(16, GOLD_HI);
    const glow = sprite(160, GOLD);

    let W = 0, H = 0, dpr = 1, mobile = false, N = 140;
    const streams: Stream[] = Array.from({ length: 5 }, (_, i) => ({
      y0: 0.12 + i * 0.19,
      amp: 22 + ((i * 7) % 13),
      freq: 2.2 + i * 0.55,
      speed: 0.9 + ((i * 3) % 5) * 0.18,
      phase: i * 1.7,
      dots: Array.from({ length: 9 }, () => ({ t: Math.random(), v: 0.035 + Math.random() * 0.05, r: 0.5 + Math.random() * 0.7 })),
    }));

    const pointer = { x: -9999, y: -9999, sx: -9999, sy: -9999 };
    let energy = 1, time = 0, last = performance.now(), running = false, visible = true, raf = 0;
    const bands = new Float32Array(5);
    let bins: Uint8Array | null = null;

    function resize() {
      const r = host!.getBoundingClientRect();
      mobile = r.width < 700;
      dpr = Math.min(window.devicePixelRatio || 1, mobile ? 1.5 : 1.75);
      W = r.width; H = r.height;
      N = mobile ? 90 : 140;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (!running) frame(performance.now());
    }

    function readAudio() {
      const an = (window as any).__soundAnalyser as AnalyserNode | null | undefined;
      if (!an) { bands.fill(0); return; }
      if (!bins || bins.length !== an.frequencyBinCount) bins = new Uint8Array(an.frequencyBinCount);
      an.getByteFrequencyData(bins);
      // five roughly log-spaced bands, one per stream
      const edges = [1, 3, 6, 12, 24, 48];
      for (let b = 0; b < 5; b++) {
        let s = 0;
        for (let k = edges[b]; k < edges[b + 1]; k++) s += bins[k];
        const v = s / ((edges[b + 1] - edges[b]) * 255);
        bands[b] += (v - bands[b]) * 0.25;
      }
    }

    // point on stream i at t ∈ [0, 1], with waveform displacement along the normal
    function point(i: number, t: number, echo: number, out: { x: number; y: number }) {
      const s = streams[i];
      const coreX = W * (mobile ? mx : cx), coreY = H * (mobile ? my : cy);
      const x0 = -W * 0.04, y0 = H * (mobile ? 0.05 + s.y0 * 0.6 : s.y0);
      const c1x = W * 0.3, c1y = y0, c2x = coreX - W * 0.22, c2y = coreY;
      const u = 1 - t;
      const bx = u * u * u * x0 + 3 * u * u * t * c1x + 3 * u * t * t * c2x + t * t * t * coreX;
      const by = u * u * u * y0 + 3 * u * u * t * c1y + 3 * u * t * t * c2y + t * t * t * coreY;
      const dx = 3 * u * u * (c1x - x0) + 6 * u * t * (c2x - c1x) + 3 * t * t * (coreX - c2x);
      const dy = 3 * u * u * (c1y - y0) + 6 * u * t * (c2y - c1y) + 3 * t * t * (coreY - c2y);
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len, ny = dx / len;
      const env = Math.pow(Math.sin(Math.PI * Math.min(1, t * 1.15)), 0.9) * Math.pow(u, 0.5);
      const a = s.amp * energy * (1 + bands[i] * 2.6) * (mobile ? 0.7 : 1);
      const w = Math.sin(t * s.freq * 6.283 - time * s.speed + s.phase + echo * 0.5) + 0.35 * Math.sin(t * s.freq * 14 + time * 1.6 + echo);
      let px = bx + nx * a * env * w, py = by + ny * a * env * w;
      // pluck away from the pointer
      const ddx = px - pointer.sx, ddy = py - pointer.sy, dd = Math.hypot(ddx, ddy);
      if (dd < 190) { const f = (1 - dd / 190) * 34 * env; px += (ddx / (dd || 1)) * f; py += (ddy / (dd || 1)) * f; }
      out.x = px; out.y = py;
    }

    const p = { x: 0, y: 0 };
    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (!still) time += dt;
      readAudio();
      pointer.sx += (pointer.x - pointer.sx) * 0.12;
      pointer.sy += (pointer.y - pointer.sy) * 0.12;
      const loud = (bands[0] + bands[1] + bands[2] + bands[3] + bands[4]) / 5;

      ctx!.clearRect(0, 0, W, H);
      ctx!.globalCompositeOperation = 'lighter';

      for (let i = 0; i < 5; i++) {
        for (let e = 0; e < 3; e++) {
          ctx!.beginPath();
          for (let k = 0; k <= N; k++) {
            point(i, k / N, e, p);
            k ? ctx!.lineTo(p.x, p.y) : ctx!.moveTo(p.x, p.y);
          }
          ctx!.strokeStyle = e ? `rgba(${ECHO[e - 1]}, ${0.16 * (0.8 + bands[i])})` : `rgba(${GOLD_HI}, ${0.58 * (0.8 + bands[i] * 0.5)})`;
          ctx!.lineWidth = e ? 1 : 1.6;
          ctx!.stroke();
        }
        for (const d of streams[i].dots) {
          if (!still) d.t += d.v * dt * (1 + bands[i] * 2) * energy;
          if (d.t > 1) d.t -= 1;
          point(i, d.t, 0, p);
          const size = 13 * d.r * (1 - d.t * 0.5);
          ctx!.globalAlpha = 0.85 * Math.sin(Math.PI * d.t);
          ctx!.drawImage(dot, p.x - size, p.y - size, size * 2, size * 2);
        }
        ctx!.globalAlpha = 1;
      }

      // core: glow + sonar rings
      const coreX = W * (mobile ? mx : cx), coreY = H * (mobile ? my : cy);
      const pulse = 1 + Math.sin(time * 2.2) * 0.06 + loud * 0.9;
      const g = (mobile ? 90 : 150) * pulse;
      ctx!.globalAlpha = 0.7;
      ctx!.drawImage(glow, coreX - g, coreY - g, g * 2, g * 2);
      ctx!.globalAlpha = 1;
      for (let r = 0; r < 3; r++) {
        const ph = ((time * (0.35 + loud) + r / 3) % 1);
        ctx!.beginPath();
        ctx!.arc(coreX, coreY, 8 + ph * (mobile ? 70 : 120), 0, Math.PI * 2);
        ctx!.strokeStyle = `rgba(${GOLD_HI}, ${0.35 * (1 - ph)})`;
        ctx!.lineWidth = 1;
        ctx!.stroke();
      }
      ctx!.beginPath();
      ctx!.arc(coreX, coreY, 3.2 + loud * 3, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(${GOLD_HI}, 0.95)`;
      ctx!.fill();
      ctx!.globalCompositeOperation = 'source-over';

      if (running) raf = requestAnimationFrame(frame);
    }

    const play = () => { if (running || still || !visible || document.hidden) return; running = true; last = performance.now(); raf = requestAnimationFrame(frame); };
    const pause = () => { running = false; cancelAnimationFrame(raf); };

    new ResizeObserver(resize).observe(host);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? play() : pause(); }).observe(host);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    host.addEventListener('pointermove', (e) => { const r = host.getBoundingClientRect(); pointer.x = e.clientX - r.left; pointer.y = e.clientY - r.top; if (pointer.sx < -5000) { pointer.sx = pointer.x; pointer.sy = pointer.y; } });
    host.addEventListener('pointerleave', () => { pointer.x = pointer.y = pointer.sx = pointer.sy = -9999; });
    window.addEventListener('scroll', () => { energy = 1 + Math.min(1, window.scrollY / Math.max(1, H)) * 0.8; }, { passive: true });

    resize();
    canvas.classList.add('is-on');
    play();
  }

  const go = () => document.querySelectorAll<HTMLCanvasElement>('[data-signal]').forEach(start);
  // Content first: wait for load, a short beat, then an idle moment before starting the visual.
  const later = () => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 2500 }) : go()), 1200);
  if (document.readyState === 'complete') later();
  else window.addEventListener('load', later, { once: true });
</script>
