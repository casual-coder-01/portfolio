---
/**
 * Lightweight video: nothing downloads until the viewer asks.
 * Desktop hover plays a muted preview; click plays with sound and native controls.
 */
import type { VideoItem } from '../data/creative';
import { url } from '../lib/url';
interface Props { video: VideoItem; featured?: boolean }
const { video, featured = false } = Astro.props;
const src = url(`/media/video/${video.slug}.mp4`);
const webm = url(`/media/video/${video.slug}.webm`);
const posterWebp = url(`/media/video/${video.slug}-poster.webp`);
const posterJpg = url(`/media/video/${video.slug}-poster.jpg`);
const ratio = video.width / video.height;
const portrait = ratio < 1;
---
<figure class:list={['vc', { 'vc--portrait': portrait, 'vc--featured': featured }]} style={`--r:${ratio.toFixed(4)}`} data-reveal>
  <div class="vc__frame" data-video>
    <video
      class="vc__video"
      preload="none"
      playsinline
      poster={posterJpg}
      width={video.width}
      height={video.height}
      aria-label={`${video.title} — video, ${video.duration}`}
    >
      <source src={src} type="video/mp4" />
      <source src={webm} type="video/webm" />
    </video>
    <picture class="vc__poster" aria-hidden="true">
      <source srcset={posterWebp} type="image/webp" />
      <img src={posterJpg} alt="" width={video.width} height={video.height} loading="lazy" decoding="async" />
    </picture>
    <button class="vc__play" type="button" data-play aria-label={`Play video: ${video.title}`}>
      <span class="vc__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
      </span>
      <span class="vc__len label">{video.duration}</span>
    </button>
  </div>
  <figcaption class="vc__cap">
    <span class="vc__title">{video.title}</span>
    <span class="label vc__meta">{video.kind === 'spec' ? 'Spec concept' : 'Brand work'} · {video.tools}</span>
    <span class="vc__desc">{video.description}</span>
  </figcaption>
</figure>

<style>
  .vc { margin: 0; display: grid; gap: 0.9rem; align-content: start; }
  .vc__frame { position: relative; aspect-ratio: var(--r); background: #000; overflow: hidden; border-radius: var(--radius); }
  .vc__video, .vc__poster, .vc__poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vc__poster { transition: opacity 0.35s var(--ease); }
  .vc__frame.is-previewing .vc__poster, .vc__frame.is-playing .vc__poster { opacity: 0; pointer-events: none; }
  .vc__play {
    position: absolute; left: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: 0.6rem;
    background: rgba(12, 13, 15, 0.72); color: #fff; border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px; padding: 0.45rem 0.9rem 0.45rem 0.5rem; min-height: 2.75rem;
    transition: background 0.2s var(--ease);
  }
  @supports (backdrop-filter: blur(1px)) { .vc__play { backdrop-filter: blur(6px); } }
  .vc__play:hover { background: rgba(12, 13, 15, 0.9); }
  .vc__icon { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: #fff; color: #111; }
  .vc__len { color: #e9e7e2; }
  .vc__frame.is-playing .vc__play { display: none; }
  .vc__cap { display: grid; gap: 0.3rem; }
  .vc__title { font-weight: 600; font-size: var(--fs-md); letter-spacing: -0.01em; }
  .vc__desc { font-size: var(--fs-sm); color: var(--ink-2); max-width: 34rem; }
  .vc--portrait .vc__frame { max-height: 78vh; max-width: calc(78vh * var(--r)); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((frame) => {
    const video = frame.querySelector('video')!;
    const btn = frame.querySelector<HTMLButtonElement>('[data-play]')!;
    const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let playing = false;

    btn.addEventListener('click', () => {
      playing = true;
      frame.classList.remove('is-previewing');
      frame.classList.add('is-playing');
      video.muted = false;
      video.controls = true;
      video.currentTime = 0;
      video.play().catch(() => {});
      video.focus();
    });

    if (canHover && !reduce) {
      frame.addEventListener('mouseenter', () => {
        if (playing) return;
        video.muted = true;
        video.loop = true;
        video.play().then(() => frame.classList.add('is-previewing')).catch(() => {});
      });
      frame.addEventListener('mouseleave', () => {
        if (playing) return;
        video.pause();
        frame.classList.remove('is-previewing');
      });
    }
    video.addEventListener('ended', () => { if (playing) video.controls = true; });
  });
</script>
