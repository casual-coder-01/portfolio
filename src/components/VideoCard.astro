---
/**
 * Video tile. Nothing heavy loads until the viewer presses play.
 *  - drive: shows the Drive thumbnail, then swaps in Google Drive's player
 *  - local: native <video> with MP4 + WebM
 */
import type { VideoItem } from '../data/creative';
import { url } from '../lib/url';
interface Props { video: VideoItem; index?: number; featured?: boolean }
const { video, index = 0, featured = false } = Astro.props;
const n = String(index + 1).padStart(2, '0');
const poster =
  video.kind === 'drive'
    ? `https://drive.google.com/thumbnail?id=${video.driveId}&sz=w1280`
    : url(`/media/video/${video.slug}-poster.jpg`);
const embed = video.kind === 'drive' ? `https://drive.google.com/file/d/${video.driveId}/preview` : '';
const link = video.kind === 'drive' ? `https://drive.google.com/file/d/${video.driveId}/view` : url(`/media/video/${video.slug}.mp4`);
---
<figure class:list={['vt', { 'vt--featured': featured }]} style={`--r:${video.ratio.toFixed(4)}`} data-reveal>
  <div class="vt__frame" data-vt data-kind={video.kind} data-embed={embed}>
    {video.kind === 'local' ? (
      <video class="vt__media" preload="none" playsinline poster={poster} aria-label={video.title}>
        <source src={url(`/media/video/${video.slug}.mp4`)} type="video/mp4" />
        <source src={url(`/media/video/${video.slug}.webm`)} type="video/webm" />
      </video>
    ) : (
      <img class="vt__media vt__poster" src={poster} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.opacity=0" />
    )}
    <div class="vt__shade" aria-hidden="true"></div>
    <button class="vt__play" type="button" data-play aria-label={`Play video: ${video.title}`}>
      <span class="vt__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg></span>
    </button>
    <span class="vt__n label" aria-hidden="true">{n}</span>
  </div>
  <figcaption class="vt__cap">
    <span class="vt__title">{video.title}</span>
    <a class="vt__open label" href={link} target="_blank" rel="noopener">Open ↗</a>
  </figcaption>
</figure>

<style>
  .vt { margin: 0; display: grid; gap: 0.8rem; min-width: 0; }
  .vt__frame {
    position: relative; aspect-ratio: var(--r); max-width: 100%; overflow: hidden; border-radius: 6px;
    background: radial-gradient(120% 90% at 20% 10%, #1d2740 0%, var(--bg-2) 60%);
    border: 1px solid var(--line);
  }
  .vt__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease), opacity 0.4s; }
  .vt__frame:hover .vt__poster { transform: scale(1.04); }
  .vt__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vt__shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(4, 5, 8, 0.65)); pointer-events: none; }
  .vt__play {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: 4.25rem; height: 4.25rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--gold); color: #111; border: 0;
    box-shadow: 0 0 0 0 rgba(217, 178, 111, 0.5); transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .vt__frame:hover .vt__play { transform: scale(1.08); box-shadow: 0 0 0 12px rgba(217, 178, 111, 0.14); }
  .vt--featured .vt__play { width: 5.5rem; height: 5.5rem; }
  .vt__n { position: absolute; left: 1rem; top: 0.9rem; color: var(--text); opacity: 0.8; }
  .vt__frame.is-playing .vt__play, .vt__frame.is-playing .vt__shade, .vt__frame.is-playing .vt__n { display: none; }
  .vt__cap { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .vt__title { font-weight: 600; font-size: var(--fs-md); letter-spacing: -0.01em; }
  .vt__open { text-decoration: none; color: var(--text-3); white-space: nowrap; }
  .vt__open:hover { color: var(--gold); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-vt]').forEach((frame) => {
    const btn = frame.querySelector<HTMLButtonElement>('[data-play]');
    btn?.addEventListener('click', () => {
      frame.classList.add('is-playing');
      if (frame.dataset.kind === 'drive') {
        const iframe = document.createElement('iframe');
        iframe.src = frame.dataset.embed!;
        iframe.allow = 'autoplay; fullscreen';
        iframe.allowFullscreen = true;
        iframe.title = btn.getAttribute('aria-label')?.replace('Play video: ', '') ?? 'Video';
        frame.appendChild(iframe);
        iframe.focus();
      } else {
        const v = frame.querySelector('video')!;
        v.controls = true;
        v.play().catch(() => {});
        v.focus();
      }
    });
  });
</script>
